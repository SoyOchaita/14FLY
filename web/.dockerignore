# ========================================
# 🚫 ARCHIVOS Y CARPETAS A IGNORAR EN DOCKER
# ========================================

# 🔹 Dependencias locales (innecesarias dentro del contenedor)
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log
package-lock.json

# 🔹 Configuración local o temporal
.DS_Store
.vscode
.git
.gitignore
.env.local
.env.development.local
.env.test.local
.env.production.local

# 🔹 Archivos de pruebas y builds temporales
coverage
dist
.tmp
out-tsc

# 🔹 Archivos del CLI de Angular que no se necesitan en la imagen final
.angular
karma.conf.js
tsconfig.spec.json
tsconfig.server.json

# 🔹 Documentación o archivos del entorno local
README.md
*.md
*.log

# 🔹 Otras carpetas fuera del scope de Angular
../db/
../api/
